{
  "expo": {
    "name": "PaceForge",
    "slug": "paceforge",
    "version": "1.0.0",
    "scheme": "paceforge",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "Fr.paceforge.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.paceforge.mobile",
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESPIRATORY_RATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5F6E"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "PaceForge lit les mesures que tu autorises pour afficher ton poids, tes pas et tes tendances de santé dans ton compte.",
          "NSHealthUpdateUsageDescription": "PaceForge utilise Apple Santé pour ton suivi du poids, des pas et des tendances de santé. Cette version consulte tes mesures sans en ajouter ni les modifier.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "react-native-ble-manager",
        {
          "bluetoothAlwaysPermission": "PaceForge se connecte au capteur cardiaque que tu choisis pour afficher ton pouls en direct.",
          "neverForLocation": true,
          "isBleRequired": false
        }
      ],
      "./plugins/with-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "4e22becd-175c-45e0-bf2d-3e40607a6305"
      }
    },
    "owner": "fneyron"
  }
}

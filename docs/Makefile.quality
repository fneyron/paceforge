# Quality targets, to paste into the Makefile (docs/quality.md): the same commands as .github/workflows/quality.yml.
PY ?= .venv/bin/python
TEST_DATABASE_URL ?= postgresql+asyncpg://postgres:postgres@localhost:5432/paceforge_test

.PHONY: lint typecheck typecheck-baseline test test-pg

lint:  ## ruff, the rules of pyproject.toml
	$(PY) -m ruff check .

typecheck:  ## mypy, no new finding against mypy-baseline.txt
	$(PY) scripts/mypy_baseline.py check

typecheck-baseline:  ## accept today's findings as the baseline (review its diff before committing it)
	$(PY) scripts/mypy_baseline.py update

test:  ## the suite, a temporary SQLite file per test
	$(PY) -m pytest -q

test-pg:  ## the suite on PostgreSQL, its schema built by the migrations first
	DATABASE_URL=$(TEST_DATABASE_URL) SECRET_KEY=x-test DEBUG=true $(PY) -m alembic upgrade head
	TEST_DATABASE_URL=$(TEST_DATABASE_URL) $(PY) -m pytest -q

# PaceForge — every setting of app/config.py with its default. Copy it to .env for a local run (README.md);
# in production the values come from Coolify's environment (docker-compose.prod.yml), not from a file.

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL, used in the emails' links and the OAuth callbacks
BASE_URL=http://localhost:8000
# Signs the sessions and the email links: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# The app refuses to start with this default unless DEBUG=true.
SECRET_KEY=change-me-to-a-random-secret-key
# Fernet keys encrypting the stored provider tokens, comma-separated, newest first (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())");
# empty: a key derived from SECRET_KEY
ENCRYPTION_KEYS=
APP_NAME=PaceForge
# true: /docs, SQL echo, cookies over HTTP, no SECRET_KEY check — never in production
DEBUG=false
# Bike and triathlon planning (hidden for now; true brings them back)
CYCLING_ENABLED=false
# Error reporting: a Sentry DSN; empty, nothing is loaded or sent
SENTRY_DSN=
# A browser session ends this many days after sign-in, whatever its activity (logout revokes it at once)
SESSION_LIFETIME_DAYS=90

# ── Database ───────────────────────────────────────────────────────────────────
# With docker compose the host is "db"; with a venv, your own PostgreSQL (docker-compose.yml publishes its db on 5433)
DATABASE_URL=postgresql+asyncpg://paceforge:paceforge@db:5432/paceforge
# docker-compose.yml and docker-compose.prod.yml only: the password of the paceforge database user
POSTGRES_PASSWORD=paceforge
# Connection pools, per uvicorn worker and per Celery task (the budget is explained in app/config.py)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TASK_POOL_SIZE=1
DB_TASK_MAX_OVERFLOW=2

# ── Redis ──────────────────────────────────────────────────────────────────────
# Rate limits and sync state (db 0), the Celery broker (db 1); the host is "redis" with docker compose
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Mail: the sign-up confirmations and password resets ────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
# Required: without them no sign-up can be confirmed and no password reset sent
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaceForge <contact@paceforge.fr>

# ── Strava ─────────────────────────────────────────────────────────────────────
# The shared Strava application (one for every athlete): enable it only once Strava has granted it the capacity
STRAVA_SHARED_APP_ENABLED=false
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# A random string only Strava and the app know (the webhook subscription's hub.verify_token): not this default in production
STRAVA_WEBHOOK_VERIFY_TOKEN=paceforge-verify
# The shared app's webhook subscription id; empty: discovered
STRAVA_SUBSCRIPTION_ID=

# ── Background lookups (the tests turn them off) ───────────────────────────────
# Each trace's road/track/trail surface from OpenStreetMap
SURFACE_FETCH=true
# The hourly COROS and Garmin syncs
COROS_SYNC=true
GARMIN_SYNC=true
# Each outdoor activity's altitude and start weather from Open-Meteo, in the syncs
ACTIVITY_ENV_FETCH=true

# ── Backups (docker-compose.prod.yml only; docs/ops-runbook.md) ────────────────
# An off-host copy of each daily dump when set, e.g. s3://my-bucket/paceforge (the local rotation runs regardless)
BACKUP_S3_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For an S3-compatible store (Scaleway, OVH, Hetzner…): its endpoint URL and region
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=

# The tests on PostgreSQL instead of SQLite (make test-pg builds the schema first)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/paceforge_test
